{
  "name": "chainproof-monorepo",
  "private": true,
  "workspaces": [
    "packages/*",
    "apps/*"
  ],
  "scripts": {
    "dev": "npm run dev -w @chainproof/web",
    "build": "npm run build --workspaces",
    "worker": "npx ts-node apps/web/src/workers/reportWorker.ts",
    "db:push": "npm run db:push -w @chainproof/db",
    "db:generate": "npm run db:generate -w @chainproof/db",
    "contracts:compile": "npm run compile -w @chainproof/contracts",
    "contracts:deploy": "npm run deploy -w @chainproof/contracts",
    "crypto:build": "npm run build -w @chainproof/crypto"
  },
  "devDependencies": {
    "tsconfig-paths": "^4.2.0"
  }
}
